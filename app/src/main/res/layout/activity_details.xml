<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="56dp"
    android:paddingTop="28dp"
    android:paddingEnd="56dp"
    android:paddingBottom="28dp">

    <FrameLayout
        android:layout_width="240dp"
        android:layout_height="360dp"
        android:background="@drawable/poster_bg"
        android:elevation="6dp"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/cream"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/original"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:textColor="@color/cream"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.8"
                android:textColor="@color/cream"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ratings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gold"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/awards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/gold"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/peach"
                android:textSize="17sp" />

            <ScrollView
                android:id="@+id/textScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants"
                android:fadeScrollbars="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:overScrollMode="never"
                android:scrollbarThumbVertical="@color/peach"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

            <TextView
                android:id="@+id/overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.9"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/cream"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/whyYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/cream"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/critics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.8"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/cream"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.8"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/cream"
                android:textSize="13.5sp"
                android:visibility="gone" />

                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLampa"
                    style="@style/HomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/watch"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnPin"
                    style="@style/HomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnFav"
                    style="@style/HomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnLike"
                    style="@style/HomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="44dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowRemove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWatched"
                    style="@style/HomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/menu_watched"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnSkip"
                    style="@style/HomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="44dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/menu_skip"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnBack"
                    style="@style/HomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="44dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/back"
                    android:textSize="15sp" />
            </LinearLayout>
    </LinearLayout>
</LinearLayout>
