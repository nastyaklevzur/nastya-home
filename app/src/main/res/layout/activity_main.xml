<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Вкладки: переключаются по фокусу, выбранная подсвечена и когда фокус ушёл в контент -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/tabHome"
                style="@style/TabChip"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/tabMovies"
                style="@style/TabChip"
                android:text="@string/tab_movies" />

            <TextView
                android:id="@+id/tabCams"
                style="@style/TabChip"
                android:text="@string/tab_cams" />

            <TextView
                android:id="@+id/tabApps"
                style="@style/TabChip"
                android:text="@string/tab_apps" />
        </LinearLayout>

        <!-- Страницы: видна одна, остальные GONE -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="false">

            <include
                layout="@layout/page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/page_movies"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/page_cams"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/page_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Футер: версия и кредиты -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.55"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingTop="3dp"
            android:paddingBottom="5dp"
            android:textColor="@color/cream"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Плашка «Убрал … Назад — вернуть» на 6 секунд (SC-3, SC-4) -->
    <TextView
        android:id="@+id/undoBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/undo_bg"
        android:elevation="16dp"
        android:fontFamily="sans-serif-medium"
        android:maxWidth="640dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="22dp"
        android:paddingTop="9dp"
        android:paddingEnd="22dp"
        android:paddingBottom="9dp"
        android:textColor="@color/cream"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
