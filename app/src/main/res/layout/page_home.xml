<?xml version="1.0" encoding="utf-8"?>
<!-- Вкладка «Главная»: шапка, новости, топ-10, «Продолжить просмотр», камеры -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:overScrollMode="never"
    android:paddingBottom="6dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="6dp">

            <!-- Шапка: приветствие слева, погода и часы справа -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHello"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:textColor="@color/peach"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:alpha="0.85"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/cream"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weatherBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/app_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/tvWeatherIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWeatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:textColor="@color/cream"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/tvWeatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/cream"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:textColor="@color/cream"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.75"
                        android:includeFontPadding="false"
                        android:textColor="@color/cream"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/chip_bg"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="👤"
                    android:textColor="@color/chip_text"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Лента новостей -->
            <LinearLayout
                android:id="@+id/newsBox"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginStart="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNewsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/peach"
                    android:textSize="12sp" />

                <TextSwitcher
                    android:id="@+id/newsSwitcher"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:clipChildren="true" />
            </LinearLayout>

            <!-- Кино -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="48dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/section_movies"
                    android:textColor="@color/cream"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/btnToMovies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/chip_bg"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:text="@string/to_movies"
                    android:textColor="@color/chip_text"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:alpha="0.5"
                    android:text="@string/hint_menu"
                    android:textColor="@color/cream"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:textColor="@color/cream"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/rvMovies"
                android:layout_width="match_parent"
                android:layout_height="214dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="48dp"
                android:paddingTop="8dp"
                android:paddingEnd="48dp"
                android:paddingBottom="4dp" />

            <!-- Продолжить просмотр (заполняет другой агент; пока скрыто) -->
            <TextView
                android:id="@+id/tvContinueHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_continue"
                android:textColor="@color/cream"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/rvContinueHome"
                android:layout_width="match_parent"
                android:layout_height="214dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="48dp"
                android:paddingTop="8dp"
                android:paddingEnd="48dp"
                android:visibility="gone"
                android:paddingBottom="4dp" />

            <!-- Камеры -->
            <LinearLayout
                android:id="@+id/camsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/section_cams"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnToCams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/chip_bg"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:text="@string/to_cams"
                    android:textColor="@color/chip_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/rvCams"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="48dp"
                android:paddingTop="7dp"
                android:paddingEnd="48dp"
                android:paddingBottom="10dp" />
    </LinearLayout>
</ScrollView>
