<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NastyaHome" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_home</item>
        <item name="android:colorBackground">@color/plum</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:textColorPrimary">@color/cream</item>
        <item name="colorAccent">@color/peach</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="alertDialogTheme">@style/Theme.NastyaHome.Dialog</item>
    </style>

    <style name="Theme.NastyaHome.Player" parent="Theme.NastyaHome">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.NastyaHome.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/plum</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:textColorPrimary">@color/cream</item>
        <item name="android:textColorAlertDialogListItem">@color/cream</item>
        <item name="colorAccent">@color/peach</item>
        <item name="android:windowMinWidthMajor">40%</item>
        <item name="android:windowMinWidthMinor">40%</item>
    </style>

    <style name="HomeButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
